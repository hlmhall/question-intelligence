# Sample environment variable configuration for Practical Foundations for Question Intelligence
# Copy this file to `.env` and adjust values as needed for your environment.

# Path to raw input data CSVs (required)
RAW_DIR=data/raw/

# Path to store processed data (required)
PROCESSED_DIR=data/processed/

# Random seed for reproducibility (optional)
RANDOM_SEED=42

# Path to user feedback storage (optional)
FEEDBACK_STORE=feedback_store.json

# Path to save/load trained model (required)
MODEL_PATH=models/classifier.pkl

# Port for running the Streamlit app (optional)
STREAMLIT_PORT=8501
